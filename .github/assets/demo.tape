Output demo.gif

# Set up a 1500x700 terminal with 24px font.
Set FontSize 24
Set Width 1500
Set Height 700
Set Shell fish

# Type a command in the terminal.
Type "nextup"

# Pause for dramatic effect...
Sleep 500ms

# Run the command by pressing enter.
Enter

# Admire the output for a bit.
Sleep 3s

# Shuffle names
Ctrl+N
Sleep 500ms
Ctrl+N
Sleep 500ms
Ctrl+N
Sleep 500ms

# Show individual timer
Sleep 8s

# Skip next person
Down
Sleep 500ms
Down
Sleep 8s

# Close out
Hide
Ctrl+C
Type "clear"
Enter
Show
Sleep 3s
